{
  "uid": "modelgauge-benchmarks",
  "title": "ModelGauge \u2014 Benchmark Results",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "Live experiment",
      "type": "link",
      "url": "/d/modelgauge-live",
      "targetBlank": false,
      "keepTime": true
    },
    {
      "title": "Serving detail",
      "type": "link",
      "url": "/d/modelgauge-serving",
      "targetBlank": false,
      "keepTime": true
    },
    {
      "title": "Resources",
      "type": "link",
      "url": "/d/modelgauge-resources",
      "targetBlank": false,
      "keepTime": true
    },
    {
      "title": "Completed results",
      "type": "link",
      "url": "/d/modelgauge-benchmarks",
      "targetBlank": false,
      "keepTime": true
    },
    {
      "title": "Infrastructure",
      "type": "link",
      "url": "/d/modelgauge-overview",
      "targetBlank": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Latest throughput (tokens/s)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "expr": "modelgauge_benchmark_tokens_per_second",
          "legendFormat": "{{node}} {{model}} {{mode}} t{{threads}} p{{prompt}} g{{generation}}"
        }
      ],
      "description": "Latest completed direct llama-bench prompt/generation speed by model, threads and token counts. Higher is faster for equal workloads. This is retained evidence, not live measurement; a flat line may mean no new run completed.",
      "maxDataPoints": 400
    },
    {
      "id": 2,
      "title": "Relative standard deviation",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "expr": "modelgauge_benchmark_relative_stddev",
          "legendFormat": "{{node}} {{model}} t{{threads}} p{{prompt}} g{{generation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "description": "Standard deviation divided by mean direct tokens/s; 0.10 means 10%. Lower indicates more repeatable samples. This is the latest completed result and not proof of thermal stability.",
      "maxDataPoints": 400
    },
    {
      "id": 3,
      "title": "Measured peak RSS by workload",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "expr": "modelgauge_peak_rss_bytes",
          "legendFormat": "{{node}} {{model}} {{workload}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "description": "GNU-time measured process peak resident memory in bytes for the completed memory workload. Use to budget physical RAM; not total VM memory or concurrent serving fit.",
      "maxDataPoints": 400
    },
    {
      "id": 4,
      "title": "Memory reservation (1.25 \u00d7 RSS)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "expr": "modelgauge_memory_reservation_bytes",
          "legendFormat": "{{node}} {{model}} {{workload}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "description": "Heuristic memory budget: completed peak RSS \u00d7 1.25. A 1.6 GiB observation suggests 2 GiB reservation. Not an enforced limit or guaranteed production capacity.",
      "maxDataPoints": 400
    },
    {
      "id": 5,
      "title": "Retained completed result count",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "expr": "modelgauge_runs",
          "legendFormat": "{{status}}"
        }
      ],
      "description": "Count of retained completed result records. Failed/interrupted work is not retained in the completed store; the live dashboard shows the latest transient failure/cancellation state.",
      "maxDataPoints": 400
    }
  ]
}
