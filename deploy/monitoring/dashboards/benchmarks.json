 {"id":3,"title":"Measured peak RSS by workload","type":"timeseries","gridPos":{"x":0,"y":9,"w":12,"h":9},"datasource":{"uid":"prometheus","type":"prometheus"},"targets":[{"expr":"modelgauge_peak_rss_bytes","legendFormat":"{{node}} {{model}} {{workload}}"}],"fieldConfig":{"defaults":{"unit":"bytes"}}},
