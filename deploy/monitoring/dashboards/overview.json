{
  "uid": "modelgauge-overview",
  "title": "ModelGauge \u2014 Infrastructure and Operations",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Scrape health",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "expr": "up",
          "legendFormat": "{{job}} {{instance}}"
        }
      ],
      "description": "Prometheus target reachability: 1 means last scrape succeeded, 0 means it failed. Missing target data is not zero workload or a stopped benchmark."
    },
    {
      "id": 2,
      "title": "CPU usage",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "expr": "100 * (1 - avg by(node) (rate(node_cpu_seconds_total{mode=\"idle\"}[2m])))",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "description": "Non-idle CPU percentage averaged across CPUs of each monitored Linux node over 2 minutes. High values show utilization, not necessarily saturation; compare throughput and waiting. Excludes host processes outside the VM.",
      "maxDataPoints": 400
    },
    {
      "id": 3,
      "title": "Available RAM",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "expr": "node_memory_MemAvailable_bytes",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "description": "Linux guest MemAvailable in bytes, an estimate of memory available for new work. Low values suggest pressure; this is not physical laptop headroom.",
      "maxDataPoints": 400
    },
    {
      "id": 4,
      "title": "Disk available",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "expr": "node_filesystem_avail_bytes{mountpoint=\"/\"}",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "description": "Free filesystem space in bytes on the monitored Linux root filesystem. Leave room for models, evidence and monitoring retention. Does not measure disk performance.",
      "maxDataPoints": 400
    },
    {
      "id": 5,
      "title": "Swap used",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "expr": "node_memory_SwapTotal_bytes - node_memory_SwapFree_bytes",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "description": "Guest swap total minus swap free, in bytes. Nonzero usage can be historical; inspect changing swap counters to establish active paging.",
      "maxDataPoints": 400
    },
    {
      "id": 6,
      "title": "Foreground operation active",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "expr": "modelgauge_active_operation"
        }
      ],
      "description": "1 means a controller-owned operation is currently executing, including model inspection/installation. 0 means none active. Not a queue size or proof of benchmark throughput."
    }
  ],
  "links": [
    {
      "title": "Live experiment",
      "type": "link",
      "url": "/d/modelgauge-live",
      "targetBlank": false,
      "keepTime": true
    },
    {
      "title": "Serving detail",
      "type": "link",
      "url": "/d/modelgauge-serving",
      "targetBlank": false,
      "keepTime": true
    },
    {
      "title": "Resources",
      "type": "link",
      "url": "/d/modelgauge-resources",
      "targetBlank": false,
      "keepTime": true
    },
    {
      "title": "Completed results",
      "type": "link",
      "url": "/d/modelgauge-benchmarks",
      "targetBlank": false,
      "keepTime": true
    },
    {
      "title": "Infrastructure",
      "type": "link",
      "url": "/d/modelgauge-overview",
      "targetBlank": false,
      "keepTime": true
    }
  ]
}
